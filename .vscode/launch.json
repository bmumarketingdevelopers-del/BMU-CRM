{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Website (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @bmu/web dev",
      "serverReadyAction": { "pattern": "- Local:.+(https?://\\S+)", "uriFormat": "%s", "action": "openExternally" }
    },
    {
      "name": "API (NestJS)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @bmu/api dev"
    }
  ],
  "compounds": [
    { "name": "Website + API", "configurations": ["Website (Next.js)", "API (NestJS)"] }
  ]
}
