# BMU Hub live settings, used by docker-compose.prod.yml (and by `pnpm start` if you copy them into apps/api/.env).
# Copy to .env.production and change every value marked CHANGE. Never commit the real file.

NODE_ENV=production

# --- Database -------------------------------------------------------------------------------------------------
POSTGRES_USER=bmu
POSTGRES_PASSWORD=CHANGE-to-a-long-random-password
POSTGRES_DB=bmu_hub
# Inside Docker the database host is "postgres". Use the same password as above.
DATABASE_URL=postgresql://bmu:CHANGE-to-a-long-random-password@postgres:5432/bmu_hub?schema=public
# Only if DATABASE_URL goes through PgBouncer (transaction mode): a direct connection for live events and the jobs lock.
DIRECT_DATABASE_URL=

# --- Security (required) --------------------------------------------------------------------------------------
# Signs sign-in sessions. At least 32 random characters, e.g. the output of: openssl rand -hex 32
JWT_SECRET=CHANGE-me-run-openssl-rand-hex-32
# Encrypts saved Instagram/Google/etc. sign-ins. Keep it forever (changing it means reconnecting accounts).
INTEGRATIONS_KEY=CHANGE-me-run-openssl-rand-hex-32

# --- Addresses ------------------------------------------------------------------------------------------------
# Your public website address (emails, payment links, passkeys). The API is reached at APP_URL/api.
APP_URL=https://hub.bmumarketing.in
CORS_ORIGINS=https://hub.bmumarketing.in
# The proxies in front (Docker network, Caddy/Nginx) are trusted for visitor addresses.
TRUST_PROXY=uniquelocal

# --- First login ----------------------------------------------------------------------------------------------
# Becomes the Founder login when the database is set up. No demo accounts are created on a live server.
OWNER_EMAIL=bmumarketingpaidtools@gmail.com

# --- Email (needed so people receive sign-in codes) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BMU Marketing <hello@bmumarketing.in>"
# Before email works, set OTP_LOG=1 to read your first sign-in code with: docker compose logs api | grep "Sign-in code"
# Remove it again once email is set up.
OTP_LOG=

# --- Logs -----------------------------------------------------------------------------------------------------
# json = one JSON line per log entry (for log tools); leave empty for readable lines. LOG_REQUESTS=1 logs each request.
LOG_FORMAT=json
LOG_REQUESTS=1

# --- Optional services (each feature has a built-in fallback without them) -------------------------------------
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
INBOUND_EMAIL_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# With `--profile forecast`: http://forecast:8000
FORECAST_URL=
