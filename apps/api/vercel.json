{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter \"@bmu/api...\"",
  "buildCommand": "cd ../.. && pnpm --filter @bmu/shared build && pnpm --filter @bmu/api build && pnpm --filter @bmu/api db:deploy",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{dist,prisma/migrations}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
