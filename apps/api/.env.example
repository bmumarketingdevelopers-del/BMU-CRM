# Copy to .env (cp .env.example .env). Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://bmu:bmu@localhost:5432/bmu_hub?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000"
# Secret used to sign sign-in tokens. Change it in production.
JWT_SECRET="dev-only-change-me"
# Your own email. It gets a Founder login so you can sign in with it.
OWNER_EMAIL=bmumarketingpaidtools@gmail.com
# In development the sign-in code is shown on screen and printed in this terminal.
NODE_ENV=development
# Razorpay (optional). Leave empty to use the "test payment" button in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (needed for payments to mark invoices paid automatically).
RAZORPAY_WEBHOOK_SECRET=
# Web address of the app, used for links in emails (Pay now, Open in BMU Hub).
APP_URL="http://localhost:3000"
# Email (optional). Set SMTP_HOST to send real emails (sign-in codes, invoices, quotes, reminders,
# draft ready, automation emails). Without it every email is saved to Command Centre > Platform > Outbox.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BMU Marketing <hello@bmumarketing.in>"
# Where uploaded files (deliverables, message attachments) are stored. Default: apps/api/storage
STORAGE_DIR=
# AI Copilot (optional). Without a key every AI feature still works with basic, ready-made suggestions.
# Create a key at console.anthropic.com → API Keys, paste it here, then restart BMU Hub.
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: claude-opus-5-5 for drafting and Ask BMU, claude-haiku-4-5 for quick tasks.
AI_MODEL=
AI_FAST_MODEL=
# WhatsApp (optional, v17). Without these, WhatsApp messages wait in Command Centre > Outbox > WhatsApp queue and
# the inbox still shows them. From Meta's WhatsApp Business Cloud API (developers.facebook.com > your app > WhatsApp):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# For incoming WhatsApp messages: set the webhook in Meta to https://<your API address>/webhooks/whatsapp with this
# verify token, and put the app secret here so only Meta can post to it (required on a live server).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Incoming email (optional, v17): any mail service that can forward an email as JSON ({ from, fromName, subject, text,
# messageId }) to https://<your API address>/webhooks/email with the header X-BMU-Webhook-Secret set to this value.
INBOUND_EMAIL_SECRET=
# Integrations (optional, v19). Without keys, use test accounts on Command Centre > Integrations.
# Encrypts saved sign-ins. Required on a live server: any long random value (keep it; changing it means reconnecting).
INTEGRATIONS_KEY=
# The public https address of this API (used for sign-in return links and for Instagram to fetch images).
# Default: APP_URL + /api
API_PUBLIC_URL=
# Meta (Instagram, Facebook pages, Meta Ads): developers.facebook.com > your app
META_APP_ID=
META_APP_SECRET=
# LinkedIn pages: linkedin.com/developers > your app (Community Management API)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Google (YouTube, Google Ads, GA4): console.cloud.google.com > Credentials > OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads only: developer token (Ads manager account > Tools > API Center) and, if you use one, the manager account id
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Set to 1 to allow test accounts on a live server (they are always allowed in development)
INTEGRATIONS_TEST_ACCOUNTS=
# Webhooks to private addresses (localhost, 10.x, 192.168.x) are allowed in development. Set 0 to block them anyway.
WEBHOOKS_ALLOW_PRIVATE=
# v20 forecasting (optional): the Python service in services/forecast. Leave empty to use the built-in forecasts.
FORECAST_URL=
# v20 phone push notifications go through Expo's push service. Set 1 to turn them off.
PUSH_DISABLED=
# Only for testing against a stand-in push service (default: https://exp.host/--/api/v2/push/send).
EXPO_PUSH_URL=
# v20 speed: heavy screens are cached per person for up to a minute and cleared on any change. Set 0 to turn off.
READ_CACHE=
# v21 backend processes (see docs/backend.md). all = API + jobs in one process (default, used by pnpm dev);
# api = HTTP only; worker = background jobs only (started with `pnpm start:worker`).
PROCESS_ROLE=
# Worker health port (http://localhost:4001/health/ready).
WORKER_PORT=
# json = one JSON log line per entry; LOG_REQUESTS=1 logs every request with its id; LOG_LEVEL=debug for more detail.
LOG_FORMAT=
LOG_REQUESTS=
LOG_LEVEL=
# Behind Docker or a load balancer: which proxies to trust for visitor addresses (loopback, uniquelocal, or a number).
TRUST_PROXY=
# Live events between processes go through Postgres. Set 0 to turn off. Behind PgBouncer set DIRECT_DATABASE_URL.
EVENT_BRIDGE=
DIRECT_DATABASE_URL=
# Most database connections each process opens (default 10). On Supabase's free plan use 5: the pooler allows about 15.
DATABASE_POOL_MAX=
# 1 = print sign-in codes in the API log on a live server (only for the very first sign-in before email works).
OTP_LOG=
# Demo data when seeding: on in development, off with NODE_ENV=production. Set 0 or 1 to choose.
SEED_DEMO=
# 0 = pnpm dev never starts its own private database (.bmu-data); use when your data lives in an installed PostgreSQL.
EMBEDDED_DB=
