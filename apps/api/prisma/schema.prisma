// ---------------------------------------------------------------------------
// v9: automations ("when this happens, do that") and saved analytics reports

model AutomationRule {
  id                String    @id @default(cuid())
  orgId             String
  name              String
  description       String?
  enabled           Boolean   @default(true)
  /// Trigger key, e.g. lead_created, invoice_overdue (see packages/shared/src/automations-types.ts)
  trigger           String
  /// Trigger options, e.g. { days: 3 }
  triggerArgs       Json      @default("{}")
  /// [{ field, op, value }] all must match
  conditions        Json      @default("[]")
  /// [{ type, ...args }] run in order
  actions           Json      @default("[]")
  templateKey       String?
  createdById       String?
  runCount          Int       @default(0)
  lastRunAt         DateTime?
  /// Records created/changed before this are ignored by event triggers (set when the rule is created or enabled)
  watermark         DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  /// v14: set when the rule was moved into a workflow (the rule is then switched off)
  movedToWorkflowId String?

  runs AutomationRun[]

  @@index([orgId, enabled])
  @@map("automation_rules")
}

model AutomationRun {
  id        String   @id @default(cuid())
  orgId     String
  ruleId    String
  entity    String
  entityId  String
  /// Same rule never fires twice for the same entity + key (e.g. one reminder per invoice per overdue step)
  dedupeKey String
  status    String // success | failed | skipped
  detail    Json     @default("{}")
  at        DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, entity, entityId, dedupeKey])
  @@index([orgId, at])
  @@map("automation_runs")
}

model SavedReport {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  name      String
  /// { metric, dimension, period, from, to, chart }
  config    Json
  pinned    Boolean  @default(false)
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, userId])
  @@map("saved_reports")
}

