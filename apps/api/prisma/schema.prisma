// BMU Hub schema: all entities in data_model of BMU_Hub_Architecture_Prompt.json.
// Rules: every table carries orgId (tenant), soft delete via deletedAt, money as integer paise.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  staff
  client
  creator
}

enum UserStatus {
  invited
  active
  suspended
}

enum AccessScope {
  none
  own
  team
  department
  branch
  all
}

enum BillingType {
  monthly
  one_time
  per_unit
}

enum Tier {
  starter
  growth
  premium
}

enum LeadStage {
  new
  contacted
  discovery
  proposal_sent
  won
  lost
}

enum ProposalStatus {
  draft
  sent
  accepted
  rejected
  expired
  superseded
}

enum EngagementStatus {
  pending_payment
  onboarding
  blocked
  planning
  awaiting_plan_approval
  in_production
  in_review
  awaiting_final_payment
  delivered
  active_retainer
  paused
  offboarding
  closed
}

enum RequirementStatus {
  pending
  received
  blocked
  waiting
}

enum PlanStatus {
  draft
  internal_review
  sent_to_client
  changes_requested
  approved
}

enum DeliverableStatus {
  planned
  in_production
  in_qc
  qc_failed
  qc_passed
  ready_for_client
  changes_requested
  approved
  scheduled
  published
}

enum TaskStatus {
  todo
  in_progress
  blocked
  waiting
  in_qc
  done
  cancelled
}

enum QcOutcome {
  pass
  fail
}

enum RequestStatus {
  received
  scope_check
  in_scope
  quoted
  approved
  paid
  in_progress
  done
  declined
  rescheduled
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  void
  credit_noted
}

enum MessageSource {
  app
  whatsapp
  email
}

enum ChecklistKind {
  requirements
  qc
}

enum PriceBookStatus {
  draft
  active
  archived
}

model Organisation {
  id        String    @id @default(cuid())
  name      String
  plan      String    @default("standard")
  settings  Json      @default("{}")
  branding  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches   Branch[]
  users      User[]
  roles      Role[]
  clientOrgs ClientOrg[]
  leads      Lead[]
  priceBooks PriceBook[]
  audit      AuditEvent[]

  @@map("organisations")
}

model Branch {
  id                     String    @id @default(cuid())
  orgId                  String
  name                   String
  city                   String
  workingHoursCalendarId String?
  createdAt              DateTime  @default(now())
  deletedAt              DateTime?
  /// v11 people: the branch's working-hours calendar ("10:00"–"19:00", days 0=Sun…6=Sat)
  workStart              String?
  workEnd                String?
  workDays               Int[]     @default([])

  org         Organisation @relation(fields: [orgId], references: [id])
  departments Department[]
  users       User[]

  @@index([orgId])
  @@map("branches")
}

model Department {
  id         String    @id @default(cuid())
  orgId      String
  branchId   String
  name       String
  headUserId String?
  deletedAt  DateTime?

  branch        Branch         @relation(fields: [branchId], references: [id])
  teams         Team[]
  users         User[]
  sops          SOP[]
  flowTemplates FlowTemplate[]

  @@unique([branchId, name])
  @@index([orgId])
  @@map("departments")
}

model Team {
  id           String    @id @default(cuid())
  orgId        String
  departmentId String
  name         String
  leadUserId   String?
  deletedAt    DateTime?

  department Department @relation(fields: [departmentId], references: [id])
  users      User[]

  @@index([orgId])
  @@map("teams")
}

model User {
  id           String     @id @default(cuid())
  orgId        String
  type         UserType
  name         String
  email        String?
  phone        String?
  status       UserStatus @default(invited)
  managerId    String?
  departmentId String?
  teamId       String?
  branchId     String?
  /// v10 craft: job function within the base role (video_editor, script_writer, social_media_manager, developer, ux_ui_designer, graphic_designer, …)
  specialty    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  /// v11 people: joining date, employment type (full_time | intern | contract), photo, and when they left (offboarded → "Former")
  joiningDate    DateTime? @db.Date
  employmentType String?
  photoUrl       String?
  leftAt         DateTime?
  /// v18 capacity: contracted hours per week (before leave and holidays)
  weeklyHours    Int       @default(45)

  org            Organisation @relation(fields: [orgId], references: [id])
  manager        User?        @relation("ReportsTo", fields: [managerId], references: [id])
  reports        User[]       @relation("ReportsTo")
  department     Department?  @relation(fields: [departmentId], references: [id])
  team           Team?        @relation(fields: [teamId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])
  roles          UserRole[]
  clientUser     ClientUser?
  ownedLeads     Lead[]
  managedClients ClientOrg[]
  engagementsAm  Engagement[] @relation("EngagementAm")
  tasks          Task[]       @relation("TaskOwner")
  creator        Creator?
  attendance     Attendance[]
  eodReports     EODReport[]

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([managerId])
  @@map("users")
}

model Role {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  baseRole String
  isCustom Boolean @default(false)

  org         Organisation @relation(fields: [orgId], references: [id])
  permissions Permission[]
  users       UserRole[]

  @@unique([orgId, name])
  @@map("roles")
}

model Permission {
  roleId     String
  capability String
  scope      AccessScope
  rule       String // raw rule from the spec matrix, e.g. "within discount_limit"

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, capability])
  @@map("permissions")
}

model UserRole {
  userId   String
  roleId   String
  scopeRef String @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, scopeRef])
  @@map("user_roles")
}

model ClientOrg {
  id             String    @id @default(cuid())
  /// v14: values of the org's custom fields for this record, { [key]: value }
  customFields   Json      @default("{}")
  orgId          String
  leadId         String?   @unique
  name           String
  industry       String?
  gstin          String?
  billingAddress String?
  /// v10 service: optional billing details for the GST tax invoice (editable by client owner / finance)
  legalName      String?
  /// Two-digit GST state code of the place of supply, e.g. "29" for Karnataka
  placeOfSupply  String?
  billingEmail   String?
  amUserId       String?
  health         String    @default("green")
  /// v10 deliver: who must approve plans and drafts: any (one approver) | owner (an owner must approve) | all (every owner and approver)
  approvalMode   String    @default("any")
  tenureStart    DateTime?
  createdAt      DateTime  @default(now())

  /// v11 core: archived records are hidden from lists, kept for reports and restorable
  archivedAt     DateTime?
  archivedReason String?
  deletedAt      DateTime?

  /// v11 clients: primary contact { name, phone, email } (manual clients; proposal clients use the lead contact)
  primaryContact       Json?
  branchId             String?
  /// v11 clients: how the account was created: proposal | manual | lead | import
  source               String    @default("proposal")
  /// v11 clients: onboarding (new, gates from G1) | migration (existing client moved in at its current gate)
  startMode            String    @default("onboarding")
  /// v11 clients: confirmed | pending (manual client without online payment: Finance must confirm the money)
  paymentStatus        String    @default("confirmed")
  /// v11 clients: health set by hand (AM / AM Lead) with a reason
  healthReason         String?
  healthOverriddenAt   DateTime?
  healthOverriddenBy   String?
  /// v11 clients: offboarding { status, reason, lastCycle, checklist, requestedAt, approvedAt, completedAt, clientConfirmedAt }
  offboarding          Json?
  /// v11 clients: client users are read-only until this date after offboarding, then archived
  readOnlyUntil        DateTime?
  /// v16 creative: posts need the client's approval before they can be scheduled and published (default on)
  publishNeedsApproval Boolean   @default(true)

  org         Organisation  @relation(fields: [orgId], references: [id])
  am          User?         @relation(fields: [amUserId], references: [id])
  brands      ClientBrand[]
  users       ClientUser[]
  engagements Engagement[]
  invoices    Invoice[]
  threads     Thread[]

  @@index([orgId])
  @@map("client_orgs")
}

model ClientBrand {
  id          String    @id @default(cuid())
  orgId       String
  clientOrgId String
  name        String
  location    String?
  deletedAt   DateTime?

  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id])

  @@map("client_brands")
}

model ClientUser {
  userId      String   @id
  orgId       String
  clientOrgId String
  clientRole  String // client_owner | client_approver | client_viewer | client_finance
  brandScope  String[]

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id])

  @@map("client_users")
}

model Lead {
  id                 String    @id @default(cuid())
  orgId              String
  source             String
  contact            Json // { name, email, phone, company }
  need               String
  budgetPaise        Int?
  score              Int       @default(0)
  stage              LeadStage @default(new)
  ownerId            String?
  lostReason         String?
  serviceIds         String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  // v10 sell: follow-ups, duplicate detection, activity
  nextFollowUpAt     DateTime?
  followUpNotifiedAt DateTime?
  duplicateOfId      String?
  lastActivityAt     DateTime?

  /// v11 core: archived records are hidden from lists, kept for reports and restorable
  archivedAt     DateTime?
  archivedReason String?

  /// v11 ops: first-reply SLA for leads added in the CRM or by the website (working hours)
  firstReplyDueAt     DateTime?
  firstReplyAt        DateTime?
  firstReplyAlertedAt DateTime?
  createdById         String?
  /// v14: values of the org's custom fields for this record, { [key]: value }
  customFields        Json      @default("{}")

  org        Organisation   @relation(fields: [orgId], references: [id])
  owner      User?          @relation(fields: [ownerId], references: [id])
  proposals  Proposal[]
  activities LeadActivity[]

  @@index([orgId, stage])
  @@map("leads")
}

model PriceBook {
  id            String          @id @default(cuid())
  orgId         String
  version       String
  effectiveFrom DateTime
  status        PriceBookStatus @default(draft)

  org      Organisation @relation(fields: [orgId], references: [id])
  services Service[]
  bundles  Bundle[]
  addOns   AddOn[]

  @@unique([orgId, version])
  @@map("price_books")
}

model Service {
  id           String      @id @default(cuid())
  orgId        String
  priceBookId  String
  key          String // stable catalogue id, e.g. "digital_marketing"
  name         String
  track        String
  billingType  BillingType
  unit         String?
  excludedNote String?

  priceBook   PriceBook     @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  tiers       ServiceTier[]
  engagements Engagement[]

  @@unique([priceBookId, key])
  @@map("services")
}

model ServiceTier {
  serviceId           String
  tier                Tier
  pricePaise          Int
  isFromPrice         Boolean  @default(false)
  withShootPricePaise Int?
  deliverables        String[]
  revisionRounds      Int      @default(2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, tier])
  @@map("service_tiers")
}

model Bundle {
  id          String   @id @default(cuid())
  orgId       String
  priceBookId String
  key         String
  name        String
  serviceKeys String[]
  discountPct Int

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, key])
  @@map("bundles")
}

model AddOn {
  id            String  @id @default(cuid())
  orgId         String
  priceBookId   String
  name          String
  pricePaise    Int?
  unit          String?
  isCustomQuote Boolean @default(false)

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@map("add_ons")
}

model AuditEvent {
  id       String   @id @default(cuid())
  orgId    String
  actorId  String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())
  ip       String?
  /// v20: tamper-evident chain per organisation. hash = sha256(prevHash + canonical event); seq counts up per org.
  seq      Int?
  prevHash String?
  hash     String?

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId, entity, entityId])
  @@index([orgId, seq])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Sell: proposals and agreements

model Proposal {
  id                    String         @id @default(cuid())
  orgId                 String
  leadId                String
  priceBookId           String
  lines                 Json // ProposalLine[]: prices are a snapshot, so later price changes never alter a proposal
  subtotalPaise         Int
  bundleDiscountPaise   Int            @default(0)
  extraDiscountPct      Int            @default(0)
  discountPaise         Int            @default(0)
  gstPaise              Int
  totalPaise            Int
  validUntil            DateTime
  status                ProposalStatus @default(draft)
  version               Int            @default(1)
  publicToken           String         @unique @default(cuid())
  discountNeedsApproval Boolean        @default(false)
  discountApprovedById  String?
  createdById           String?
  sentAt                DateTime?
  viewedAt              DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
  // v10 sell: revisions, view tracking, multi-step discount approval, renewals
  kind                  String         @default("new") // new | renewal
  renewalClientOrgId    String?
  renewalEngagementIds  String[]       @default([])
  rootId                String? // first version's id; versions of one proposal share it
  supersededById        String?
  supersededAt          DateTime?
  changeNote            String?
  viewCount             Int            @default(0)
  lastViewedAt          DateTime?
  discountStatus        String         @default("none") // none | pending | approved | rejected

  lead           Lead                    @relation(fields: [leadId], references: [id])
  agreement      Agreement?
  invoices       Invoice[]
  changeRequests ProposalChangeRequest[]
  discountSteps  DiscountApprovalStep[]

  @@index([orgId, status])
  @@map("proposals")
}

model Agreement {
  id           String    @id @default(cuid())
  orgId        String
  proposalId   String    @unique
  templateId   String?
  signedPdfUrl String?
  signedAt     DateTime?
  signer       Json? // { name, email, ip }

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@map("agreements")
}

// ---------------------------------------------------------------------------
// Deliver: engagements, cycles, requirements, plans, deliverables

model Engagement {
  id               String           @id @default(cuid())
  /// v14: values of the org's custom fields for this record, { [key]: value }
  customFields     Json             @default("{}")
  orgId            String
  clientOrgId      String
  serviceId        String
  tier             Tier
  billingType      BillingType
  status           EngagementStatus @default(pending_payment)
  currentGate      String           @default("G1")
  amId             String?
  startDate        DateTime?
  endDate          DateTime?
  finalSignedOffAt DateTime?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?
  renewedAt        DateTime?
  renewalCount     Int              @default(0)

  /// v11 core: archived records are hidden from lists, kept for reports and restorable
  archivedAt     DateTime?
  archivedReason String?

  /// v11 clients: manual client without online payment: work can't pass Gate 1 until Finance confirms the money
  paymentPending  Boolean   @default(false)
  /// v11 clients: pause (AM Lead approved) { until, reason }; pauseState keeps what to restore on resume
  pausedUntil     DateTime?
  pauseReason     String?
  pauseState      Json?
  /// v11 clients: existing client moved in at its current gate (sales steps skipped)
  migrated        Boolean   @default(false)
  migrationReason String?
  /// v11 clients: first month of service, e.g. "2026-11"
  startMonth      String?

  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])
  am        User?     @relation("EngagementAm", fields: [amId], references: [id])
  cycles    Cycle[]
  requests  Request[]
  threads   Thread[]

  @@index([orgId, status])
  @@map("engagements")
}

model Cycle {
  id            String    @id @default(cuid())
  orgId         String
  engagementId  String
  period        String // e.g. "2026-10" for retainers, "project" for one-time
  rcdAt         DateTime?
  planningDue   DateTime?
  firstDraftDue DateTime?
  status        String    @default("onboarding")
  /// v10 deliver: retainer month invoice issued when the cycle started
  invoiceId     String?
  /// v10 deliver: "auto" (scheduled job) | "manual" (AM button) | null (first cycle)
  startedBy     String?
  /// v10 deliver: unused quota rolled over from the previous month [{ type, count, fromPeriod }]
  carriedOver   Json      @default("[]")
  createdAt     DateTime  @default(now())

  engagement   Engagement        @relation(fields: [engagementId], references: [id])
  requirements RequirementItem[]
  plans        Plan[]
  deliverables Deliverable[]

  @@unique([engagementId, period])
  @@map("cycles")
}

model RequirementItem {
  id            String            @id @default(cuid())
  orgId         String
  cycleId       String
  label         String
  type          String // asset | access | info | payment
  status        RequirementStatus @default(pending)
  blockedReason String?
  waitingFor    String?
  ownerId       String?
  dateRequested DateTime          @default(now())

  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@map("requirement_items")
}

model Plan {
  id           String     @id @default(cuid())
  orgId        String
  cycleId      String
  content      Json
  status       PlanStatus @default(draft)
  approvedById String?
  approvedAt   DateTime?

  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@map("plans")
}

model Deliverable {
  id                   String            @id @default(cuid())
  orgId                String
  cycleId              String
  type                 String
  title                String
  status               DeliverableStatus @default(planned)
  revisionRoundsUsed   Int               @default(0)
  approvedVersionId    String?
  dueAt                DateTime?
  departmentId         String?
  flowKey              String?
  /// v10 deliver: content calendar
  scheduledAt          DateTime?
  channel              String?
  publishedAt          DateTime?
  liveUrl              String?
  /// v16 creative: post text for the content calendar, and when the team was told it is due to go out
  caption              String?
  publishDueNotifiedAt DateTime?

  /// v11 core: archived records are hidden from lists, kept for reports and restorable
  archivedAt     DateTime?
  archivedReason String?

  cycle    Cycle     @relation(fields: [cycleId], references: [id])
  versions Version[]
  tasks    Task[]

  @@map("deliverables")
}

model Version {
  id             String    @id @default(cuid())
  orgId          String
  deliverableId  String
  fileId         String
  number         Int
  uploadedById   String
  note           String?
  sentToClientAt DateTime?
  sentById       String?
  createdAt      DateTime  @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  file        File        @relation(fields: [fileId], references: [id])
  qcResults   QCResult[]

  @@unique([deliverableId, number])
  @@map("versions")
}

model Comment {
  id             String    @id @default(cuid())
  orgId          String
  targetType     String
  targetId       String
  timestampOrPin String?
  body           String
  isInternal     Boolean   @default(false)
  authorId       String
  createdAt      DateTime  @default(now())
  /// v10 craft: feedback marked as handled by the maker
  resolvedAt     DateTime?
  resolvedById   String?
  /// v16 creative: copied from an open comment on the previous version (that comment's id)
  carriedFromId  String?

  @@index([targetType, targetId])
  @@map("comments")
}

model Task {
  id            String     @id @default(cuid())
  orgId         String
  deliverableId String?
  engagementId  String?
  title         String
  flowStep      String?
  ownerId       String?
  departmentId  String?
  deadline      DateTime?
  status        TaskStatus @default(todo)
  dependsOn     String[]
  blockedReason String?
  timeLoggedMin Int        @default(0)
  kind          String     @default("work") // work | qc | client_review | planning
  /// v10 craft: high | normal | low, set by managers on the assignment board
  priority      String     @default("normal")
  specialty     String? // v10 craft: who should do it (ad-hoc tasks); flow tasks use flowStep
  role          String?
  sort          Int        @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // v11 core: task actions (create anywhere, subtasks, archive, drafts, blocked details, recurring)
  archivedAt           DateTime?
  archivedReason       String?
  archivedFromStatus   String?
  parentId             String?
  description          String?
  brief                String?
  references           String[]  @default([])
  /// [{ id, label, done }]
  checklist            Json      @default("[]")
  estimateMin          Int?
  /// internal tasks (training, admin, pitches) have no client
  isInternal           Boolean   @default(false)
  /// client task before Gate 3 (planning / onboarding work)
  preProduction        Boolean   @default(false)
  /// saved as a draft (by the author, or because it is out of scope without an approved add-on)
  isDraft              Boolean   @default(false)
  draftReason          String?
  outOfScope           Boolean   @default(false)
  addOnRequestId       String?
  blockedWaitingFor    String?
  blockedResponsibleId String?
  blockedExpectedAt    DateTime?
  blockedAt            DateTime?
  deadlineChanges      Int       @default(0)
  recurrenceId         String?
  createdById          String?

  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  owner       User?        @relation("TaskOwner", fields: [ownerId], references: [id])

  @@index([orgId, ownerId, status])
  @@index([parentId])
  @@map("tasks")
}

model QCResult {
  id          String    @id @default(cuid())
  orgId       String
  versionId   String
  checklistId String
  items       Json
  result      QcOutcome
  reviewerId  String
  createdAt   DateTime  @default(now())

  version Version @relation(fields: [versionId], references: [id])

  @@map("qc_results")
}

/// Immutable record of a written approval (gate passes, plan/draft/quote approvals). Never updated or deleted.
model Approval {
  id         String   @id @default(cuid())
  orgId      String
  targetType String
  targetId   String
  gate       String?
  userId     String
  at         DateTime @default(now())
  versionId  String?
  /// v11 clients: historical approval recorded when an existing client was migrated in
  migrated   Boolean  @default(false)
  /// v16 creative: where the approval came from (portal | email | whatsapp | migrated) and from which address
  via        String?
  ip         String?

  @@index([targetType, targetId])
  @@map("approvals")
}

model Request {
  id               String        @id @default(cuid())
  /// v14: values of the org's custom fields for this record, { [key]: value }
  customFields     Json          @default("{}")
  orgId            String
  engagementId     String
  type             String // revision | new_scope | urgent | question
  description      String
  status           RequestStatus @default(received)
  scopeDecision    String?
  quoteAmountPaise Int?
  timeline         String?
  slaDue           DateTime? // first reply due (working hours)
  createdById      String?
  deliverableId    String?
  addOnId          String?
  firstReplyAt     DateTime?
  resolvedAt       DateTime?
  approvedById     String?
  approvedAt       DateTime?
  invoiceId        String?
  /// v10 service: client satisfaction once done (1 = thumbs up, -1 = thumbs down)
  rating           Int?
  ratingComment    String?
  ratedAt          DateTime?
  ratedById        String?
  reopenCount      Int           @default(0)
  reopenedAt       DateTime?
  /// v11 ops: the message a request was created from
  sourceMessageId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  /// v11 clients: who handles it (default the client's AM), when the client needs it, files, raised by the AM for the client
  assigneeId       String?
  neededBy         DateTime?
  attachments      String[]      @default([])
  raisedOnBehalf   Boolean       @default(false)

  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@map("requests")
}

// ---------------------------------------------------------------------------
// Finance

model Invoice {
  id             String        @id @default(cuid())
  orgId          String
  clientOrgId    String? // empty until the first payment creates the client account
  number         String
  lines          Json
  subtotalPaise  Int
  gstPaise       Int
  totalPaise     Int
  dueDate        DateTime
  status         InvoiceStatus @default(draft)
  razorpayRef    String?
  proposalId     String?
  kind           String        @default("standard") // first_payment | retainer | project_balance | addon
  engagementId   String?
  requestId      String?
  /// v10 service: billing period for retainer invoices, e.g. "2026-10" (billing run duplicate check)
  period         String?
  createdAt      DateTime      @default(now())
  /// v11 clients: past invoice imported as a record when an existing client was migrated in
  migrated       Boolean       @default(false)
  /// v11 ops: manual invoices (who raised it, notes) and how many times the due date moved
  createdById    String?
  notes          String?
  dueDateChanges Int           @default(0)
  /// v28: when the seal and the Founder's signature were added (with the signing password), and by whom
  signedAt       DateTime?
  signedById     String?
  /// v28: delivery to the client is held until the invoice is signed (set when it was due to be sent)
  deliveryHeldAt DateTime?
  /// v29: what was printed when it was signed, so a later change of signature never alters a signed invoice:
  /// signedRole founder | client_manager; the signature and seal files; the name and designation under them
  signedRole           String?
  signatureFileId      String?
  sealFileId           String?
  signatoryName        String?
  signatoryDesignation String?

  clientOrg ClientOrg? @relation(fields: [clientOrgId], references: [id])
  proposal  Proposal?  @relation(fields: [proposalId], references: [id])
  payments  Payment[]

  @@unique([orgId, number])
  @@map("invoices")
}

model Payment {
  id           String   @id @default(cuid())
  orgId        String
  invoiceId    String
  amountPaise  Int
  method       String
  at           DateTime @default(now())
  ref          String?
  /// v11 ops: uploaded proof (bank slip, cheque photo) for an offline payment
  proofFileId  String?
  recordedById String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

