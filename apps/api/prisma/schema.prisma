  @@unique([userId, weekStart])
  @@index([orgId, status])
  @@map("timesheets")
}

/// Employee onboarding or offboarding checklist run by HR.
model PeopleProcess {
  id          String    @id @default(cuid())
  orgId       String
  userId      String
  /// onboarding | offboarding
  kind        String
  /// open | done | cancelled
  status      String    @default("open")
  startedById String
  buddyId     String?
  startDate   DateTime? @db.Date
  lastDay     DateTime? @db.Date
  /// [{ key, label, group, done, doneAt, doneById, sopId? }]
  items       Json      @default("[]")
  note        String?
  completedAt DateTime?
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, kind, status])
  @@index([userId])
  @@map("people_processes")
}

/// "I have read" acknowledgement of one SOP version.
model SopAcknowledgement {
  id      String   @id @default(cuid())
  orgId   String
  sopId   String
  userId  String
  version Int
  at      DateTime @default(now())

  @@unique([sopId, userId, version])
  @@index([userId])
  @@map("sop_acknowledgements")
}

// ---------------------------------------------------------------------------
// v11 core: shared action system (approvals, assignments, undo, drafts, saved views, watchers, tags, imports)

/// A change that waits for someone's approval (approval_matrix). On approve, the stored payload is applied by the handler registered for `action`.
model ApprovalRequest {
  id            String    @id @default(cuid())
  orgId         String
  /// handler key, e.g. task.reassign_over_capacity, task.deadline_change, task.handback
  action        String
  targetType    String
  targetId      String
  /// what to apply on approval (the handler's input) plus a before/after diff for display
  payload       Json      @default("{}")
  summary       String
  requestedById String
  /// the person who must decide; null = anyone with approverRoles
  approverId    String?
  approverRoles String[]  @default([])
  /// pending | approved | rejected | expired | cancelled
  status        String    @default("pending")
  reason        String?
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  expiresAt     DateTime
  result        Json?
  createdAt     DateTime  @default(now())

  @@index([orgId, status])
  @@index([approverId, status])
  @@index([targetType, targetId])
  @@map("approval_requests")
}

/// Every change of owner on any record (task, deliverable, lead, client AM, engagement roles…).
model Assignment {
  id                String    @id @default(cuid())
  orgId             String
  targetType        String
  targetId          String
  /// which seat changed: owner | am | strategist | producer | qc_reviewer | sales_owner
  role              String    @default("owner")
  fromUserId        String?
  toUserId          String?
  reason            String
  note              String?
  handoverNote      String?
  /// { mode: keep | extend | set, from, to, days }
  deadlineChange    Json?
  approvalRequestId String?
  /// the previous owner keeps read access until this time (7 days)
  readAccessUntil   DateTime?
  byId              String
  at                DateTime  @default(now())

  @@index([orgId, targetType, targetId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("assignments")
}

/// Before-state of a change, so it can be undone for a short time.
model UndoEntry {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  label     String
  /// [{ model, id, data }] rows to restore, plus side effects to reverse
  before    Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("undo_entries")
}

/// Autosaved form drafts (forms with more than 5 fields).
model Draft {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  entity    String
  /// form context, e.g. "new" or "new:client=abc"
  key       String   @default("new")
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entity, key])
  @@map("drafts")
}

model SavedView {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  entity    String
  name      String
  filters   Json     @default("{}")
  columns   Json     @default("[]")
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, entity])
  @@map("saved_views")
}

model Watcher {
  orgId      String
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("watchers")
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("neutral")
  createdAt DateTime @default(now())

  links TagLink[]

  @@unique([orgId, name])
  @@map("tags")
}

/// A tag on any record (task, client, lead, creator…).
model TagLink {
  tagId      String
  orgId      String
  targetType String
  targetId   String
  byId       String?
  createdAt  DateTime @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("tag_links")
}

/// CSV import: preview (validated rows) then commit.
model ImportJob {
  id                String    @id @default(cuid())
  orgId             String
  entity            String
  fileName          String?
  /// { csvColumn: fieldKey }
  mapping           Json      @default("{}")
  /// preview | committed | cancelled
  status            String    @default("preview")
  rowsTotal         Int       @default(0)
  rowsOk            Int       @default(0)
  rowsFailed        Int       @default(0)
  /// [{ row, ok, errors[], duplicate?, values }]
  rows              Json      @default("[]")
  /// [{ row, message }]
  errors            Json      @default("[]")
  createdIds        String[]  @default([])
  errorReportFileId String?
  byId              String
  createdAt         DateTime  @default(now())
  committedAt       DateTime?

  @@index([orgId, entity])
  @@map("import_jobs")
}

/// Recurring task rule: instances are generated 7 days ahead, skipping days off and holidays.
model TaskRecurrence {
  id          String    @id @default(cuid())
  orgId       String
  /// task fields copied to each instance { title, ownerId, departmentId, engagementId, priority, … }
  template    Json
  /// daily | weekly | monthly | cycle_start
  rule        String
  /// weekly: 1 = Monday … 6 = Saturday; monthly: day of month
  dayOf       Int?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  lastDate    DateTime? @db.Date
  active      Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())

  @@index([orgId, active])
  @@map("task_recurrences")
}

/// v11 clients: a quote to add a service to an existing client or change an engagement's tier. The client owner
/// approves in the app; an invoice (when there is something to pay now) must be paid before it applies.
model ClientServiceQuote {
  id                 String    @id @default(cuid())
  orgId              String
  clientOrgId        String
  /// add_service | change_tier
  kind               String
  engagementId       String?
  serviceId          String
  tier               Tier
  fromTier           Tier?
  /// first month, e.g. "2026-11" (add_service)
  startMonth         String?
  /// next_cycle | now_prorata (change_tier)
  effective          String    @default("next_cycle")
  /// paid now (first payment, or the pro-rata difference); 0 = nothing to pay now
  amountPaise        Int       @default(0)
  /// monthly price difference (change_tier), for display
  monthlyDiffPaise   Int?
  /// requested (client asked; AM to send) | sent | approved | applied | declined | cancelled
  status             String    @default("sent")
  note               String?
  requestedById      String
  requestedByClient  Boolean   @default(false)
  sentById           String?
  approvedById       String?
  approvedAt         DateTime?
  invoiceId          String?
  appliedAt          DateTime?
  resultEngagementId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([orgId, clientOrgId])
  @@index([invoiceId])
  @@map("client_service_quotes")
}

// ---------------------------------------------------------------------------
// v11 people: hierarchy actions (scheduled moves and role changes, client pods)

/// A move or role change that takes effect on a later date (applied by the people job on that day).
model PeopleScheduledChange {
  id                String    @id @default(cuid())
  orgId             String
  userId            String
  /// move | role
  kind              String
  /// move: { departmentId, teamId, managerId, branchId }; role: { roleIds }
  payload           Json
  effectiveDate     DateTime  @db.Date
  reason            String
  /// scheduled | applied | cancelled
  status            String    @default("scheduled")
  byId              String
  approvalRequestId String?
  createdAt         DateTime  @default(now())
  appliedAt         DateTime?

  @@index([orgId, status, effectiveDate])
  @@index([userId])
  @@map("people_scheduled_changes")
}

/// A client pod: an AM, a strategist and producers who serve a set of clients. New tasks for those clients default to pod members.
model ClientPod {
  id               String    @id @default(cuid())
  orgId            String
  name             String
  amUserId         String
  strategistUserId String?
  producerIds      String[]  @default([])
  clientIds        String[]  @default([])
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([orgId])
  @@map("client_pods")
}

// ---------------------------------------------------------------- v11 ops
/// A coordinator's score for a creator after a brief is delivered (one per brief).
model OpsCreatorRating {
  id        String   @id @default(cuid())
  orgId     String
  creatorId String
  briefId   String   @unique
  score     Int
  note      String
  byId      String
  createdAt DateTime @default(now())

  @@index([creatorId])
  @@map("ops_creator_ratings")
}

/// External share link for a file: expires, optional password (scrypt hash), can be revoked.
model OpsShareLink {
  id           String    @id @default(cuid())
  orgId        String
  fileId       String
  token        String    @unique
  expiresAt    DateTime
  passwordHash String?
  createdById  String
  revokedAt    DateTime?
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([fileId])
  @@map("ops_share_links")
}

/// An announcement sent to clients or the team (in-app and email through the Outbox).
model OpsAnnouncement {
  id             String   @id @default(cuid())
  orgId          String
  title          String
  body           String
  /// all_clients | segment | all_team | department
  audience       String
  /// segment: a service key (clients with that service) or a health value; department: the department id
  segment        String?
  channels       String[]
  recipientCount Int      @default(0)
  sentById       String
  createdAt      DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("ops_announcements")
}

/// Org-level integration switch (connect / disconnect by Admin) and per-client ad/social accounts (by the AM with consent).
model OpsIntegration {
  id               String    @id @default(cuid())
  orgId            String
  key              String
  /// null = org-level; otherwise the client the account belongs to
  clientOrgId      String?
  /// for client accounts: meta_ads | google_ads | instagram | facebook | youtube | linkedin
  platform         String?
  accountName      String?
  connected        Boolean   @default(true)
  consentBy        String?
  consentAt        DateTime?
  connectedById    String
  connectedAt      DateTime  @default(now())
  disconnectedAt   DateTime?
  disconnectedById String?

  @@index([orgId, key])
  @@index([clientOrgId])
  @@map("ops_integrations")
}

// ---------------------------------------------------------------- v12 dashboards
/// A dashboard: a built-in one's saved layout (key = built-in key) or a custom one (key = "custom:<id>").
model Dashboard {
  id             String    @id @default(cuid())
  orgId          String
  key            String
  builtin        String?
  name           String
  description    String?
  /// team | admin | client
  surface        String    @default("team")
  /// menu | team_home | admin_home (custom only)
  placement      String    @default("menu")
  /// { everyone, roles[], specialties[], userIds[] } (custom only)
  audience       Json      @default("{}")
  /// DashboardWidget[]
  layout         Json      @default("[]")
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  archivedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions DashboardVersion[]

  @@unique([orgId, key])
  @@index([orgId, archivedAt])
  @@map("dashboards")
}

/// Every save of a dashboard, so any earlier version can be restored.
model DashboardVersion {
  id          String   @id @default(cuid())
  orgId       String
  dashboardId String
  name        String
  placement   String
  audience    Json
  layout      Json
  note        String?
  savedById   String?
  savedAt     DateTime @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, savedAt])
  @@map("dashboard_versions")
}

/// v13 foundation: feature flags per organisation (Command Centre → System health). Missing row = the default.
model FeatureFlag {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  enabled     Boolean
  roles       String[] @default([])
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([orgId, key])
  @@map("feature_flags")
}

/// v13 foundation: an event-bus delivery that failed. Retried with backoff, then kept as "dead" for a person to retry or dismiss.
model EventFailure {
  id            String    @id @default(cuid())
  orgId         String?
  subscriber    String
  eventKind     String
  entity        String?
  event         Json
  error         String
  attempts      Int       @default(1)
  status        String    @default("retrying") // retrying | dead | resolved | dismissed
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@map("event_failures")
}

/// v13 foundation: smart search index. One row per searchable record, kept fresh by the event bus.
/// Permissions are not stored here: search uses it only to find candidates, then each area's own access rules decide.
model SearchDoc {
  id        String   @id @default(cuid())
  orgId     String
  kind      String
  entityId  String
  title     String
  keywords  String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([kind, entityId])
  @@index([orgId, kind])
  @@map("search_docs")
}

// ---------------------------------------------------------------------------
// v14: workflows, custom fields, forms, pipelines

/// A workflow: a trigger, start conditions and a tree of steps (actions, if/else, waits, approvals).
model WorkflowDef {
  id               String    @id @default(cuid())
  orgId            String
  name             String
  description      String?
  enabled          Boolean   @default(true)
  trigger          String
  triggerArgs      Json      @default("{}")
  /// { match: all|any, conditions: [{ field, op, value }] }
  start            Json      @default("{}")
  steps            Json      @default("[]")
  versionNumber    Int       @default(1)
  currentVersionId String?
  templateKey      String?
  movedFromRuleId  String?
  /// Records created/changed before this are ignored by event triggers
  watermark        DateTime  @default(now())
  /// Engine memory across runs, e.g. { lastAssignedUserId }
  state            Json      @default("{}")
  runCount         Int       @default(0)
  lastRunAt        DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  versions WorkflowVersion[]
  runs     WorkflowRun[]

  @@index([orgId, enabled])
  @@map("workflow_defs")
}

/// Every saved edit is a new version. Runs stay on the version they started with.
model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  number      Int
  trigger     String
  triggerArgs Json     @default("{}")
  start       Json     @default("{}")
  steps       Json     @default("[]")
  /// The steps compiled to a flat list of instructions (see compileWorkflow in shared)
  program     Json     @default("[]")
  createdById String?
  createdAt   DateTime @default(now())

  workflow WorkflowDef   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     WorkflowRun[]

  @@unique([workflowId, number])
  @@map("workflow_versions")
}

/// One record going through one workflow. Survives restarts: the position (pc) and wake time are stored.
model WorkflowRun {
  id          String    @id @default(cuid())
  orgId       String
  workflowId  String
  versionId   String
  entity      String
  entityId    String
  dedupeKey   String
  record      String
  link        String?
  /// running | waiting | waiting_approval | done | failed | cancelled
  status      String    @default("running")
  pc          Int       @default(0)
  wakeAt      DateTime?
  approvalId  String?
  /// The trigger's record snapshot (fields, vars, people, links)
  subject     Json      @default("{}")
  meta        Json      @default("{}")
  failures    Int       @default(0)
  error       String?
  lockedUntil DateTime?
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  workflow WorkflowDef       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version  WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  steps    WorkflowRunStep[]

  @@unique([workflowId, entity, entityId, dedupeKey])
  @@index([status, wakeAt])
  @@index([orgId, startedAt])
  @@index([entity, entityId])
  @@map("workflow_runs")
}

/// What happened at each step of a run, in plain words.
model WorkflowRunStep {
  id      String   @id @default(cuid())
  orgId   String
  runId   String
  stepId  String
  kind    String
  ok      Boolean  @default(true)
  skipped Boolean  @default(false)
  text    String
  at      DateTime @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@map("workflow_run_steps")
}

/// An extra field on leads, clients, projects, requests or creators.
model CustomFieldDef {
  id          String    @id @default(cuid())
  orgId       String
  /// lead | client | engagement | request | creator
  entity      String
  key         String
  label       String
  /// text | long_text | number | money | date | select | checkbox
  type        String
  options     Json      @default("[]")
  required    Boolean   @default(false)
  helpText    String?
  position    Int       @default(0)
  /// v20 field-level permissions: roles that cannot see this field, and roles that can see but not change it.
  hiddenFrom  String[]  @default([])
  readOnlyFor String[]  @default([])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orgId, entity, key])
  @@index([orgId, entity])
  @@map("custom_field_defs")
}

/// A form that can be shared as a link or embedded on a website. Each submission creates a lead.
model FormDef {
  id             String    @id @default(cuid())
  orgId          String
  slug           String    @unique
  name           String
  title          String
  intro          String?
  fields         Json      @default("[]")
  submitLabel    String    @default("Send")
  successMessage String
  serviceIds     String[]
  enabled        Boolean   @default(true)
  submitCount    Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  submissions FormSubmission[]

  @@index([orgId])
  @@map("form_defs")
}

model FormSubmission {
  id        String   @id @default(cuid())
  orgId     String
  formId    String
  leadId    String?
  data      Json     @default("{}")
  ipHash    String?
  pageUrl   String?
  createdAt DateTime @default(now())

  form FormDef @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([orgId, createdAt])
  @@map("form_submissions")
}

/// Per-org names, order, visibility, required fields and time targets for lead stages, project phases and request statuses.
model PipelineConfig {
  id          String   @id @default(cuid())
  orgId       String
  /// lead | engagement | request
  kind        String
  stages      Json     @default("[]")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([orgId, kind])
  @@map("pipeline_configs")
}

/// WhatsApp messages written by workflows. Kept here until WhatsApp Business is connected (v19 integrations).
model WhatsAppMessage {
  id        String   @id @default(cuid())
  orgId     String
  toPhone   String
  toName    String?
  body      String
  /// queued | sent | failed
  status    String   @default("queued")
  entity    String?
  entityId  String?
  source    String   @default("workflow")
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("whatsapp_messages")
}

// ---------------------------------------------------------------- v15 AI agents

/// One AI agent for the organisation (Sales assistant, Request triage, Producer, Analyst). Off until switched on.
model Agent {
  id                 String    @id @default(cuid())
  orgId              String
  /// sales_assistant | request_triage | producer | analyst
  key                String
  enabled            Boolean   @default(false)
  /// The agent can only do what this person could do; null = the agent can't act yet.
  actsForUserId      String?
  /// 0 = no limit. When this month's AI cost reaches it, the agent keeps working in basic mode.
  monthlyBudgetPaise Int       @default(100000)
  settings           Json      @default("{}")
  lastRunAt          DateTime?
  /// New leads / requests created after this time are picked up on the next pass.
  scannedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  runs AgentRun[]

  @@unique([orgId, key])
  @@map("agents")
}

/// One agent run: what started it, what it looked at, what it did, what it asked about, and what it cost.
model AgentRun {
  id           String    @id @default(cuid())
  orgId        String
  agentId      String
  agentKey     String
  /// event | schedule | manual | ask | eval
  trigger      String
  subjectType  String?
  subjectId    String?
  subjectLabel String?
  /// running | done | failed | undone
  status       String    @default("running")
  /// ai | basic
  mode         String    @default("basic")
  summary      String?
  answer       String?
  citations    Json      @default("[]")
  notice       String?
  costPaise    Int       @default(0)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  aiLogId      String?
  actingUserId String?
  startedById  String?
  error        String?
  feedback     Int?
  feedbackById String?
  feedbackNote String?
  /// safety-check runs are hidden from the normal run log
  isEval       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  agent Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  steps AgentStep[]

  @@index([orgId, createdAt])
  @@index([agentId, createdAt])
  @@index([subjectType, subjectId])
  @@map("agent_runs")
}

/// One step of a run: a lookup, an action it took (with what is needed to undo it), a proposal or a blocked attempt.
model AgentStep {
  id         String    @id @default(cuid())
  orgId      String
  runId      String
  seq        Int
  /// read | action | proposal | blocked | note | error
  kind       String
  tool       String?
  title      String
  detail     String?
  input      Json      @default("{}")
  output     Json?
  /// auto | confirm | never | read
  policy     String?
  ok         Boolean   @default(true)
  link       String?
  /// rows to restore (UndoRow[]); null = nothing to undo
  undo       Json?
  undoneAt   DateTime?
  undoneById String?
  proposalId String?
  at         DateTime  @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, seq])
  @@map("agent_steps")
}

/// Something an agent wants to do that needs a person first (client-facing, money, someone else's work).
model AgentProposal {
  id           String    @id @default(cuid())
  orgId        String
  agentId      String
  agentKey     String
  runId        String
  action       String
  title        String
  summary      String
  /// the action's input; editable fields can be changed by the person deciding
  payload      Json      @default("{}")
  fields       Json      @default("[]")
  targetType   String?
  targetId     String?
  link         String?
  actingUserId String
  /// people who may decide besides the Founder and Admins
  deciderIds   String[]  @default([])
  /// pending | approved | rejected | failed | expired
  status       String    @default("pending")
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  result       Json?
  error        String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([orgId, status])
  @@index([targetType, targetId])
  @@map("agent_proposals")
}

/// Searchable knowledge for agents (SOPs, services, approved plans, brand kits, client notes). Postgres full-text search.
model KnowledgeChunk {
  id          String   @id @default(cuid())
  orgId       String
  /// set for client-specific knowledge, so only people who can see the client find it
  clientOrgId String?
  /// sop | service | plan | brand_kit | client_note
  sourceType  String
  sourceId    String
  part        Int      @default(0)
  title       String
  link        String?
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId, part])
  @@index([orgId, sourceType])
  @@map("knowledge_chunks")
}

// ---------------------------------------------------------------- v16 creative studio

/// A group of assets, e.g. a campaign ("Diwali 2026"), for one client or for BMU itself.
model AssetCollection {
  id          String    @id @default(cuid())
  orgId       String
  clientOrgId String?
  name        String
  description String?
  createdById String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  assets Asset[]

  @@index([orgId, clientOrgId])
  @@map("asset_collections")
}

/// One item in the asset library (image, video, design, document or link). Its files are AssetVersions.
model Asset {
  id               String    @id @default(cuid())
  orgId            String
  clientOrgId      String?
  collectionId     String?
  title            String
  /// image | video | pdf | link | other (from the current file)
  kind             String
  tags             String[]  @default([])
  aiTags           String[]  @default([])
  /// upload | deliverable (approved work, added automatically) | brand
  source           String    @default("upload")
  deliverableId    String?
  /// the client can see it in their own library
  clientVisible    Boolean   @default(false)
  currentVersionId String?
  /// usage rights, e.g. creator content licensed for 6 months
  rightsNote       String?
  rightsExpireAt   DateTime?
  creatorId        String?
  rightsWarnedAt   DateTime?
  createdById      String
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  collection AssetCollection? @relation(fields: [collectionId], references: [id])
  versions   AssetVersion[]

  @@unique([deliverableId])
  @@index([orgId, clientOrgId])
  @@index([orgId, updatedAt])
  @@map("assets")
}

model AssetVersion {
  id           String   @id @default(cuid())
  orgId        String
  assetId      String
  number       Int
  fileId       String
  note         String?
  uploadedById String
  createdAt    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, number])
  @@map("asset_versions")
}

/// A resumable upload in progress (pieces are appended to a temporary file until complete).
model UploadSession {
  id          String    @id @default(cuid())
  orgId       String
  userId      String
  name        String
  mimeType    String
  size        BigInt
  received    BigInt    @default(0)
  tmpPath     String
  /// what to do when complete: { assetId?, title?, clientOrgId?, collectionId?, tags?, note? }
  target      Json      @default("{}")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@map("upload_sessions")
}

/// Stored when a draft is finally approved: who approved which exact file, when and how, sealed with a hash.
model ApprovalCertificate {
  id            String   @id @default(cuid())
  orgId         String
  code          String   @unique
  deliverableId String
  versionId     String   @unique
  data          Json
  hash          String
  createdAt     DateTime @default(now())

  @@index([deliverableId])
  @@map("approval_certificates")
}

/// A one-tap approval link sent to one client approver for one version (email or WhatsApp).
model ProofLink {
  id        String    @id @default(cuid())
  orgId     String
  tokenHash String    @unique
  versionId String
  userId    String
  channel   String    @default("email")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([versionId])
  @@map("proof_links")
}

/// A client's social account the content calendar posts to (Instagram handle, LinkedIn page…).
model ContentChannel {
  id          String   @id @default(cuid())
  orgId       String
  clientOrgId String
  platform    String
  handle      String
  url         String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([clientOrgId, platform, handle])
  @@map("content_channels")
}

/// Results of a published post (typed in by the team until the platforms are connected). Latest row counts.
model PostMetric {
  id            String   @id @default(cuid())
  orgId         String
  deliverableId String
  reach         Int      @default(0)
  impressions   Int      @default(0)
  engagement    Int      @default(0)
  clicks        Int      @default(0)
  spendPaise    Int      @default(0)
  source        String   @default("manual")
  recordedById  String?
  createdAt     DateTime @default(now())

  @@index([deliverableId, createdAt])
  @@index([orgId, createdAt])
  @@map("post_metrics")
}

// ---------------------------------------------------------------- v17 client portal 2.0 and communications

/// One WhatsApp number or email address talking to BMU. Linked to a client (and their thread) or a lead when known.
model Conversation {
  id            String   @id @default(cuid())
  orgId         String
  /// whatsapp | email
  channel       String
  /// Last 10 digits of the phone (WhatsApp) or the lower-case email address
  address       String
  name          String?
  clientOrgId   String?
  userId        String?
  leadId        String?
  threadId      String?
  assigneeId    String?
  /// open | closed
  status        String   @default("open")
  unread        Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ConversationMessage[]

  @@unique([orgId, channel, address])
  @@index([orgId, status, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  /// in | out
  direction      String
  subject        String?
  body           String
  /// Provider message id (WhatsApp wamid, email Message-ID): a repeated webhook is ignored
  externalId     String?
  /// received | queued | sent | simulated | failed
  status         String   @default("received")
  error          String?
  authorId       String?
  /// The copy on the client's thread, when the conversation is linked to one
  messageId      String?
  aiDrafted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([orgId, externalId])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// Saved replies with {{variables}}.
model ReplyTemplate {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  /// any | whatsapp | email
  channel     String   @default("any")
  body        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@map("reply_templates")
}

/// Per person: quiet hours (IST) and the daily digest.
model NotificationSetting {
  userId       String    @id
  orgId        String
  quietStart   String?
  quietEnd     String?
  /// off | daily
  digest       String    @default("off")
  digestHour   Int       @default(18)
  lastDigestAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("notification_settings")
}

/// Emails and WhatsApp alerts held back by quiet hours or waiting for the daily digest.
model NotificationDelivery {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  /// email | whatsapp
  channel   String
  kind      String
  title     String
  body      String?
  link      String?
  /// quiet (send when quiet hours end) | digest (bundle into the daily digest)
  reason    String
  sendAfter DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sendAfter, sentAt])
  @@index([userId, sentAt])
  @@map("notification_deliveries")
}

/// A shared document (brief, proposal draft, notes) that several people edit at the same time (Yjs CRDT state).
model CollabDoc {
  id            String    @id @default(cuid())
  orgId         String
  title         String
  /// brief | proposal | notes
  kind          String    @default("brief")
  clientOrgId   String?
  engagementId  String?
  leadId        String?
  /// Clients of clientOrgId can open and edit it
  clientVisible Boolean   @default(false)
  state         Bytes
  text          String    @default("")
  version       Int       @default(0)
  createdById   String
  updatedById   String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, updatedAt])
  @@index([engagementId])
  @@index([leadId])
  @@map("collab_docs")
}

/// When a team member can be booked: weekdays and hours (IST), meeting length.
model BookingPage {
  id          String   @id @default(cuid())
  orgId       String
  userId      String   @unique
  slug        String   @unique
  title       String
  durationMin Int      @default(30)
  /// 1 = Monday ... 7 = Sunday
  days        Int[]    @default([1, 2, 3, 4, 5])
  startTime   String   @default("10:00")
  endTime     String   @default("18:00")
  /// Minimum notice in hours
  noticeHours Int      @default(4)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("booking_pages")
}

model Meeting {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  hostId      String
  startAt     DateTime
  endAt       DateTime
  clientOrgId String?
  leadId      String?
  bookedById  String?
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  agenda      String?
  location    String?
  /// requested (client/founder asked, Client Manager arranging) | awaiting (Department Head / Founder asked to
  /// confirm) | booked (fixed) | cancelled | done
  status      String    @default("booked")
  /// client | public | team | founder (Founder asked the Client Manager to arrange a call with the client)
  bookedVia   String    @default("team")
  /// v23 meeting requests: the client's time zone (IANA, e.g. "America/New_York"); times are stored in UTC
  timeZone     String    @default("Asia/Kolkata")
  /// v23: department the Client Manager brought in (its head confirms, then adds team members)
  departmentId String?
  /// v23: video-call link: the Google Meet link Google created, or one the Client Manager pasted; null = "Your
  /// meeting is scheduled" only
  joinUrl      String?
  /// v23: when the fixed time moved away from what the client asked for (client gets an apology)
  rescheduledAt DateTime?
  /// v25: why it moved (the Client Manager's words, shown to the client with the apology)
  rescheduleReason String?
  notes       String?
  summary     String?
  /// [{ text, taskId? }]
  actionItems Json      @default("[]")
  cancelledAt DateTime?
  reminderAt  DateTime?
  /// v26: when the 15-minute reminder went out (everyone taking part, with the join link)
  soonReminderAt DateTime?
  /// v23 Google Meet: the Google Calendar event (in the host's calendar) that carries the Meet link
  googleEventId String?
  /// v23: whose connected calendar holds the event (normally the host)
  googleUserId  String?
  /// v23: why the Google event could not be created or changed (shown to the team)
  googleError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants MeetingParticipant[]
  attendees    MeetingAttendee[]

  @@index([hostId, startAt])
  @@index([clientOrgId, startAt])
  @@map("meetings")
}

/// v23 meeting requests: people the Client Manager brings into a client meeting and their answers.
model MeetingParticipant {
  id              String    @id @default(cuid())
  meetingId       String
  userId          String
  /// founder | department_head | branch_manager | member
  role            String
  /// pending | accepted | reschedule (asked for a new time the same day) | invited | joined | ignored
  status          String    @default("pending")
  proposedStartAt DateTime?
  note            String?
  respondedAt     DateTime?
  /// v23 Google Meet: their reply to the Google Calendar invitation (needsAction | accepted | declined | tentative)
  googleResponse  String?
  /// v24: for a Department Head, the department they represent (a meeting can bring in several departments)
  departmentId    String?
  /// v24: who brought them in (e.g. the Client Manager or Branch Manager who added another branch's Branch Manager)
  addedById       String?
  createdAt       DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId, status])
  @@map("meeting_participants")
}

/// v23 Google Meet: people outside the team invited to a meeting (the client's people and guests) with their reply
/// as Google Calendar reports it. Team members are MeetingParticipant rows.
model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  /// The client user, when the person has a portal login
  userId    String?
  email     String
  name      String
  /// client | guest
  kind      String
  /// needsAction | accepted | declined | tentative
  response  String   @default("needsAction")
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
  @@index([userId])
  @@map("meeting_attendees")
}

/// v29: a Client Manager's own signature and signing password for invoices of their clients (password stored only as a
/// salted scrypt hash). Founders use the company signing password in Command Centre instead.
model SigningProfile {
  id              String    @id @default(cuid())
  orgId           String
  userId          String    @unique
  signatureFileId String?
  passwordHash    String?
  passwordSalt    String?
  passwordSetAt   DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@map("signing_profiles")
}

/// v23: one person's Google Calendar connection, used to create Google Meet links for the meetings they host.
/// Tokens are encrypted with INTEGRATIONS_KEY and never sent to the browser.
model CalendarConnection {
  id             String    @id @default(cuid())
  orgId          String
  userId         String    @unique
  provider       String    @default("google")
  /// The Google account it is connected to
  email          String
  tokenEnc       String?
  refreshEnc     String?
  tokenExpiresAt DateTime?
  /// connected | error | disconnected
  status         String    @default("connected")
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("calendar_connections")
}

// ---------------------------------------------------------------------------
// v18 Finance 2.0 and capacity

/// A planned invoice (milestone, retainer instalment or one-off) issued automatically on its date.
model InvoiceSchedule {
  id           String   @id @default(cuid())
  orgId        String
  clientOrgId  String
  engagementId String?
  label        String
  /// Before GST
  amountPaise  Int
  dueOn        DateTime @db.Date
  /// milestone | retainer | one_off
  kind         String   @default("milestone")
  /// planned | issued | skipped
  status       String   @default("planned")
  invoiceId    String?
  error        String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([orgId, status, dueOn])
  @@index([clientOrgId])
  @@map("invoice_schedules")
}

/// A pay-by-link for one invoice (Razorpay Payment Link, or a test link without keys).
model PaymentLink {
  id          String    @id @default(cuid())
  orgId       String
  invoiceId   String
  token       String    @unique
  /// razorpay | test
  provider    String    @default("test")
  externalId  String?   @unique
  shortUrl    String?
  amountPaise Int
  /// active | paid | cancelled
  status      String    @default("active")
  paidAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@map("payment_links")
}

/// Money received that could not be tied to an invoice automatically.
model UnmatchedPayment {
  id          String    @id @default(cuid())
  orgId       String
  provider    String
  ref         String
  amountPaise Int
  payerName   String?
  payerEmail  String?
  payerPhone  String?
  note        String?
  receivedAt  DateTime  @default(now())
  invoiceId   String?
  matchedById String?
  matchedAt   DateTime?
  ignoredAt   DateTime?

  @@unique([orgId, provider, ref])
  @@index([orgId, matchedAt])
  @@map("unmatched_payments")
}

/// An expense (claim or card spend) or a vendor bill to pay.
model Expense {
  id            String    @id @default(cuid())
  orgId         String
  /// expense | vendor_bill
  kind          String    @default("expense")
  category      String
  vendorName    String?
  billNumber    String?
  description   String
  date          DateTime  @db.Date
  dueDate       DateTime? @db.Date
  /// Before GST
  amountPaise   Int
  gstPaise      Int       @default(0)
  tdsPaise      Int       @default(0)
  clientOrgId   String?
  engagementId  String?
  /// Re-billed to the client (then it is not a cost to BMU)
  billable      Boolean   @default(false)
  invoiceId     String?
  /// submitted | approved | rejected | paid
  status        String    @default("submitted")
  receiptFileId String?
  paidAt        DateTime?
  paidRef       String?
  createdById   String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  @@index([orgId, kind, status])
  @@index([clientOrgId])
  @@index([engagementId])
  @@map("expenses")
}

/// A running stopwatch (one per person).
model ActiveTimer {
  userId       String   @id
  orgId        String
  taskId       String?
  engagementId String?
  note         String?
  startedAt    DateTime @default(now())

  @@map("active_timers")
}

/// Hours reserved for a person (or requested for a specialty) on a project in one week.
model ResourceBooking {
  id           String   @id @default(cuid())
  orgId        String
  engagementId String
  /// null = a request for someone with `specialty`
  userId       String?
  specialty    String?
  /// Monday of the week (IST)
  weekStart    DateTime @db.Date
  hours        Int
  note         String?
  /// booked | requested
  status       String   @default("booked")
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([orgId, weekStart])
  @@index([userId, weekStart])
  @@index([engagementId])
  @@map("resource_bookings")
}

// ---------------------------------------------------------------- v19 integrations, publishing and public API

/// A connected outside account: a client's Facebook page, Instagram, LinkedIn page, YouTube channel, ad account or
/// GA4 property. mode "test" is BMU's built-in test account (no keys, made-up but steady numbers).
model IntegrationAccount {
  id             String    @id @default(cuid())
  orgId          String
  /// instagram | facebook | linkedin | youtube | meta_ads | google_ads | ga4
  provider       String
  mode           String    @default("live")
  clientOrgId    String?
  name           String
  externalId     String
  /// AES-GCM encrypted tokens (never sent to the browser)
  tokenEnc       String?
  refreshEnc     String?
  tokenExpiresAt DateTime?
  scopes         String[]  @default([])
  /// connected | error | disconnected
  status         String    @default("connected")
  lastSyncAt     DateTime?
  lastError      String?
  connectedById  String
  createdAt      DateTime  @default(now())
  disconnectedAt DateTime?

  @@unique([orgId, provider, externalId])
  @@index([clientOrgId])
  @@map("integration_accounts")
}

/// One run of a connector job (publish, post results, ad results, token refresh) for the status page.
model SyncJob {
  id         String    @id @default(cuid())
  orgId      String
  accountId  String
  /// publish | post_metrics | ad_metrics | refresh
  kind       String
  /// running | ok | failed
  status     String    @default("running")
  items      Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([accountId, startedAt])
  @@index([orgId, startedAt])
  @@map("sync_jobs")
}

/// A scheduled post sent to a connected account by the publisher.
model PostPublication {
  id            String    @id @default(cuid())
  orgId         String
  deliverableId String    @unique
  accountId     String
  /// queued | publishing | published | failed
  status        String    @default("queued")
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  externalId    String?
  url           String?
  error         String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([accountId])
  @@index([status, nextAttemptAt])
  @@map("post_publications")
}

/// Daily ad and website numbers per account (and campaign) for client dashboards.
model AdMetricDaily {
  id           String   @id @default(cuid())
  orgId        String
  accountId    String
  clientOrgId  String?
  provider     String
  date         DateTime @db.Date
  campaign     String   @default("")
  spendPaise   Int      @default(0)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  sessions     Int      @default(0)
  users        Int      @default(0)
  revenuePaise Int      @default(0)
  syncedAt     DateTime @default(now())

  @@unique([accountId, date, campaign])
  @@index([clientOrgId, date])
  @@map("ad_metrics_daily")
}

/// Public API v1 key. Only a hash is stored; requests act as the person who made it, limited to its scopes.
model ApiKey {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  prefix          String
  hash            String    @unique
  scopes          String[]
  userId          String
  createdById     String
  rateLimitPerMin Int       @default(120)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId])
  @@map("api_keys")
}

/// An outside URL that receives BMU events (signed, retried).
model WebhookSubscription {
  id           String    @id @default(cuid())
  orgId        String
  url          String
  description  String?
  /// event types: exact ("lead.created"), area ("lead.*") or "*"
  events       String[]
  secretEnc    String
  active       Boolean   @default(true)
  failingSince DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@index([orgId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  orgId          String
  subscriptionId String
  type           String
  payload        Json
  /// pending | delivered | dead
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastStatus     Int?
  lastError      String?
  durationMs     Int?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// v20: security, data protection, intelligence, mobile sync

/// One signed-in device. The session token carries its id, so it can be signed out from anywhere.
model UserSession {
  id         String    @id @default(cuid())
  orgId      String
  userId     String
  /// otp | otp+totp | passkey
  method     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// Two-factor (authenticator app) for one person. The secret is sealed; recovery codes are stored as hashes.
model UserTotp {
  userId        String    @id
  orgId         String
  secretEnc     String
  enabledAt     DateTime?
  recoveryCodes String[]  @default([])
  lastUsedStep  Int?
  createdAt     DateTime  @default(now())

  @@map("user_totp")
}

model Passkey {
  id           String    @id @default(cuid())
  orgId        String
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkeys")
}

/// DPDP consent: what a person agreed to, when, where, and against which privacy notice.
model Consent {
  id            String    @id @default(cuid())
  orgId         String
  /// lead | user | form_submission
  subjectType   String
  subjectId     String
  email         String?
  phone         String?
  /// marketing | service | whatsapp | analytics
  purpose       String
  granted       Boolean   @default(true)
  /// website_enquiry | form | proposal | sign_in | manual
  source        String
  noticeVersion String
  ip            String?
  createdAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  @@index([orgId, subjectType, subjectId])
  @@index([orgId, email])
  @@map("consents")
}

/// A data principal's request (DPDP): access/export, correction or erasure, with a deadline.
model DataRequest {
  id             String    @id @default(cuid())
  orgId          String
  /// export | correction | deletion
  kind           String
  /// lead | client | user
  subjectType    String
  subjectId      String?
  requesterName  String
  requesterEmail String
  details        String?
  /// open | in_progress | done | rejected
  status         String    @default("open")
  dueAt          DateTime
  assigneeId     String?
  resolution     String?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId, status, dueAt])
  @@map("data_requests")
}

/// How long each kind of record is kept before it is anonymised or deleted (runs nightly).
model RetentionRule {
  id         String    @id @default(cuid())
  orgId      String
  /// lost_lead | otp_code | notification | audit_ip | form_submission | email_outbox | webhook_delivery | former_client_user
  recordType String
  keepDays   Int
  /// anonymise | delete
  action     String
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  lastCount  Int?

  @@unique([orgId, recordType])
  @@map("retention_rules")
}

/// Forecasts and risk scores with the reasons behind them (TypeScript model, or the optional Python service).
model Forecast {
  id          String   @id @default(cuid())
  orgId       String
  /// revenue | churn | win | slip | capacity
  kind        String
  subjectType String
  subjectId   String
  /// revenue: month (yyyy-mm); others: ""
  period      String   @default("")
  value       Float
  /// 0–100 risk or probability
  score       Int?
  reasons     Json     @default("[]")
  /// revenue: { lowPaise, highPaise, trendPaise, label, targetPaise }
  meta        Json?
  /// ts | python
  source      String   @default("ts")
  computedAt  DateTime @default(now())

  @@unique([orgId, kind, subjectType, subjectId, period])
  @@index([orgId, kind])
  @@map("forecasts")
}

/// "Tell me when this number moves unusually."
model MetricAlert {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  metricKey     String
  /// org | client
  scope         String    @default("org")
  clientOrgId   String?
  /// drop_pct | rise_pct | above | below
  condition     String
  threshold     Float
  windowDays    Int       @default(7)
  roles         String[]  @default([])
  userIds       String[]  @default([])
  active        Boolean   @default(true)
  builtIn       Boolean   @default(false)
  lastValue     Float?
  lastCheckedAt DateTime?
  lastFiredAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([orgId, active])
  @@map("metric_alerts")
}

model MetricAlertEvent {
  id        String   @id @default(cuid())
  orgId     String
  alertId   String
  subject   String
  value     Float
  baseline  Float?
  message   String
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([orgId, createdAt])
  @@map("metric_alert_events")
}

/// A dashboard or set of metrics emailed as a PDF on a schedule.
model ScheduledReport {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  /// metrics | dashboard
  kind        String
  dashboardId String?
  metricKeys  String[]  @default([])
  /// daily | weekly | monthly
  cadence     String
  dayOfWeek   Int?
  dayOfMonth  Int?
  hourIst     Int       @default(9)
  recipients  String[]
  active      Boolean   @default(true)
  nextRunAt   DateTime
  lastSentAt  DateTime?
  lastError   String?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([active, nextRunAt])
  @@map("scheduled_reports")
}

/// Company, team and person goals, tracked against a metric or by check-ins.
model Goal {
  id           String    @id @default(cuid())
  orgId        String
  title        String
  /// company | team | person
  level        String
  ownerId      String?
  departmentId String?
  metricKey    String?
  /// higher | lower: which way is good
  direction    String    @default("higher")
  startValue   Float     @default(0)
  target       Float
  unit         String    @default("")
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  archivedAt   DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  checkIns GoalCheckIn[]

  @@index([orgId, endDate])
  @@map("goals")
}

model GoalCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  value     Float
  note      String?
  byId      String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("goal_check_ins")
}

/// Mobile offline changes, applied once each (clientOpId is generated on the phone).
model SyncOp {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  clientOpId String
  entity     String
  entityId   String
  op         String
  payload    Json
  /// applied | merged | conflict | rejected
  status     String
  result     Json?
  createdAt  DateTime @default(now())

  @@unique([userId, clientOpId])
  @@map("sync_ops")
}

/// Expo push token for a person's phone (push notifications with quick actions).
model PushToken {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("push_tokens")
}

/// v21: one row per running backend process (API or worker), refreshed every 20 seconds, for System health.
model RuntimeProcess {
  id         String   @id
  role       String // all | api | worker
  host       String
  pid        Int
  version    String
  startedAt  DateTime
  lastSeenAt DateTime
  jobs       Json     @default("[]")

  @@map("runtime_processes")
}

/// v22 serverless: "first caller wins" markers, e.g. "intelligence.alerts:2026-10-09" so a daily job runs once a day
/// even though every serverless start forgets what it did, and "cron:<minute>" so a repeated cron call is ignored.
model CronClaim {
  key       String   @id
  claimedAt DateTime @default(now())

  @@map("cron_claims")
}
